title: Kazimierz Czapiński
is-pinned-card: true
tags: advisor
card-image: img/polish/czapinski.jpg
view-if: czapinski_advisor = 1
new-page: true
on-arrival: {!
// Adviser actions of technical reference 10.4.3 (card catalogue 6.6): 0 T, their own R, one shared cooldown of
// six months for all advisers (4.4); the effects are the approved P numbers, applied by PolishParty.
PolishParty.advisorView(Q, 'czapinski');
// Stage 6: the two variants of the Industry card are checked without the month's action, which the adviser waives.
Q.pl_czap_public_control_why = Q.S ? PolishProjects.optionStatus(Q, 'industrial_policy', 'public_control', {adviser: true}).reason : '';
Q.pl_czap_representation_why = Q.S ? PolishProjects.optionStatus(Q, 'industrial_policy', 'worker_representation', {adviser: true}).reason : '';
!}

= Kazimierz Czapiński

Czapiński represents Lewica PPS and concentrates on socialist education and economic doctrine.

- @economic_finance
- @economic_public_control
- @economic_representation
- @socialist_education
- @root: Return to main

@economic_finance
title: Socialist Economic Programme: progressive and wealth taxes
subtitle: Opens the Treasury card; its one step costs no month (the law, the money and the executor remain).
choose-if: {! return Q.advisor_action_timer <= 0 && !!Q.S && PolishProjects.cardAvailable(Q, 'finance_package') !}
unavailable-subtitle: [? if advisor_action_timer = 1 : 1 month before the next Committee action. ?][? if advisor_action_timer > 1 : [+ advisor_action_timer +] months before the next Committee action. ?][? if advisor_action_timer <= 0 : Needs PPS in the cabinet with the Treasury. ?]
call: polish_advisor_commit
on-arrival: advisor_action_timer = 6; last_advisor_action = 1
go-to: polish_gov_finance

@economic_public_control
title: Socialist Economic Programme: public ownership
subtitle: Opens the Industry card for the public control of a recorded plant; its one step costs no month (the act and the vote remain).
choose-if: {! return Q.advisor_action_timer <= 0 && !!Q.S && PolishProjects.optionStatus(Q, 'industrial_policy', 'public_control', {adviser: true}).available !}
unavailable-subtitle: [? if advisor_action_timer = 1 : 1 month before the next Committee action. ?][? if advisor_action_timer > 1 : [+ advisor_action_timer +] months before the next Committee action. ?][? if advisor_action_timer <= 0 : [+ pl_czap_public_control_why +] ?]
call: polish_advisor_commit
on-arrival: advisor_action_timer = 6; last_advisor_action = 1
go-to: polish_gov_industry

