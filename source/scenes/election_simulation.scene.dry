title: Election Simulation
view-if: not started
go-to: main if started
set-jump: post_election

The implemented simulator covers the approved January 1922 Polish opening model. The inherited German 1928, 1930 and 1932 scenarios have been retired from the active Polish party system.

- @opening: January 1922 Polish opening model

@opening
on-arrival: {!
if (Q.started) return;
Q.year = 1922;
Q.month = 1;
Q.old_demographics = 0;
Q.use_decimals = 0;
Q.workers = 27;
Q.old_middle = 110/9;
Q.new_middle = 50/9;
Q.rural = 53;
Q.bourgeois_landowners = 20/9;
Q.unemployed = 3;
Q.national_minorities = 30;
Q.classes = ['workers', 'old_middle', 'new_middle', 'rural', 'bourgeois_landowners', 'unemployed', 'national_minorities'];
Q.parties = ['kpp', 'pps', 'npr', 'psl_wyzwolenie', 'psl_piast', 'pschd', 'zln', 'minorities_bloc', 'other'];
Q.party_names = {'kpp':'KPP','pps':'PPS','npr':'NPR','psl_wyzwolenie':'PSL Wyzwolenie','psl_piast':'PSL Piast','pschd':'PSChD','zln':'ZLN','minorities_bloc':'Blok Mniejszości Narodowych','other':'Inne'};
Q.legacy_party_map = {'spd': 'pps', 'kpd': 'kpp', 'dvp': 'pschd', 'dnvp': 'zln'};

var opening_support = {
    'workers': [11.04,38.64,18.40,1.84,0.92,9.20,7.36,4.60,8],
    'old_middle': [1.84,9.20,12.88,3.68,5.52,18.40,29.44,11.04,8],
    'new_middle': [3.68,22.08,4.60,8.28,4.60,9.20,25.76,13.80,8],
    'rural': [1.76,3.52,1.76,28.16,29.92,5.28,13.20,4.40,12],
    'bourgeois_landowners': [0,1.84,3.68,0.92,6.44,13.80,48.76,16.56,8],
    'unemployed': [29.44,34.96,11.04,1.84,0.92,4.60,3.68,5.52,8],
    'national_minorities': [9.20,6.44,0.92,1.84,0.92,0.92,1.84,69.92,8]
};
for (var population_group of Q.classes) {
    for (var party_index = 0; party_index < Q.parties.length; party_index++) {
        Q[population_group + '_' + Q.parties[party_index]] = opening_support[population_group][party_index];
    }
}
for (var legacy_party in Q.legacy_party_map) {
    var polish_party = Q.legacy_party_map[legacy_party];
    for (var population_group of Q.classes) {
        Q[population_group + '_' + legacy_party] = Q[population_group + '_' + polish_party];
        Q[population_group + '_' + legacy_party + '_compat_base'] = Q[population_group + '_' + polish_party];
    }
}
Q.catholics_spd = Q.national_minorities_pps;
Q.catholics_spd_compat_base = Q.catholics_spd;
!}
go-to: main if started; election_algorithm if not started
set-jump: post_election

@post_election
on-arrival: {!
Q.simulation_largest_party_id = Q.parties[0];
for (var party of Q.parties) {
    if (Q[party + '_normalized'] > Q[Q.simulation_largest_party_id + '_normalized']) {
        Q.simulation_largest_party_id = party;
    }
}
Q.simulation_largest_party = Q.party_names[Q.simulation_largest_party_id];
!}

= January 1922 voting intentions (not parliamentary seats)

KPP: [+ kpp_votes_disp +]%

PPS: [+ pps_votes_disp +]%

