title: Next month
is-hand: true
call: polish_opening_state
go-to: polish_incompatible_save if pl_route = "incompatible"; polish_chapter_report if pl_route = "report"; sejm_election if pl_route = "sejm"; polish_speaker_election if pl_route = "speaker"; polish_presidential_sequence if pl_route = "presidency"; polish_cabinet_formation if pl_route = "cabinet"
on-arrival: {!
// Save compatibility (technical reference 19.3, Z — 0.40): a save without the current
// state schema stops here instead of continuing with old state.
if (typeof PolishRules === 'undefined' || !PolishRules.isSaveCompatible(Q)) {
    Q.polish_save_incompatible = 1;
    return;
}
// Events are routed by post_event only; main offers the ordinary turn or a mandatory sequence.
Q.has_event = 0;
// Displays of dated cooldowns (technical reference 4.4).
PolishRules.refreshMirrors(Q);
Q.polish_government_actions_available = this._compileChoices(this.game.scenes['main.govt'])
    .some(function(choice) { return choice.canChoose && this.game.scenes[choice.id].isCard; }, this);
// G4 (card catalogue 9.17): the reminder of the coming election, in the three months before it.
Q.pl_election_reminder = PolishGovernment.electionReminder(Q);
// The Parliament deck (stage 3) opens only when one of its cards can be played.
Q.polish_parliament_actions_available = this._compileChoices(this.game.scenes['main.parliament'])
    .some(function(choice) { return choice.canChoose && this.game.scenes[choice.id].isCard; }, this);
// Z — 0.60 (the user's notes of 7 X 2026): the three decks are always shown; a closed deck says why.
PolishGovernment.deckReasons(Q);
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Central Executive Committee - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Central Executive Committee - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Central Executive Committee - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 6

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

[? if pl_agreement_notices : **Agreements:** [+ pl_agreement_notices +] ?]

[? if pl_economy_notices : **Economy:** [+ pl_economy_notices +] ?]

[? if pl_election_reminder : **Elections approaching.** [+ pl_election_reminder +] [? if sejm_first_election_completed : The certified result of this election ends the chapter. ?] ?]

[? if polish_opening_government_active and time >= 6 : PPS tolerates the government but holds no ministries, so the Government Affairs deck is closed. The nine portfolios can be inspected in the Library. ?]

- @party
- @govt
- @parliament
- #advisor
- @polish_government_response
- @polish_agenda
- @polish_budget_package


@party
title: Party Affairs
is-deck: true
card-image: img/polish/polish_deck_party.jpg

- #party_affairs

@govt
title: Government Affairs
choose-if: time >= 6 and not polish_opening_government_active and (not polish_government_safeguards or polish_government_actions_available)
is-deck: true
card-image: img/polish/polish_deck_govt.jpg

- #govt_affairs

@parliament
title: Parliament
choose-if: polish_parliament_actions_available
is-deck: true
card-image: img/polish/polish_deck_parliament.jpg

- #parliament_affairs
