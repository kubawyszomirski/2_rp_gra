@confirm
title: Confirm the Committee
choose-if: {! return PolishParty.advisersStatus(Q, String(Q.pl_adv_draft || '').split(',').filter(Boolean)).available !}
unavailable-subtitle: [+ pl_adv_confirm_why +]
on-arrival: {!
PolishParty.advisersChoose(Q, String(Q.pl_adv_draft || '').split(',').filter(Boolean));
!}
go-to: result

@result
new-page: true

= Change the Central Executive Committee

