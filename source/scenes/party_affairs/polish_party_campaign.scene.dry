@unemployed
title: Work and benefits for the unemployed
subtitle: [+ pl_issue_unemployed_effect +]
choose-if: {! return PolishParty.issueCampaignStatus(Q, 'unemployed').available !}
unavailable-subtitle: [+ pl_issue_unemployed_why +]
