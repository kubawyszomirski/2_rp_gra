@only_one
title: Invest only in: [+ pl_org_pick1_name +]
choose-if: {! return PolishParty.selectionStatus(Q, [Q.pl_org_pick1]).available !}
unavailable-subtitle: [+ pl_org_confirm_why +]
on-arrival: {!
// Z — 0.57: the choice is carried out at once, without a page of confirmation.
Q.pl_org_pick2 = '';
PolishParty.organizationsChoose(Q, [Q.pl_org_pick1]);
!}
go-to: result

