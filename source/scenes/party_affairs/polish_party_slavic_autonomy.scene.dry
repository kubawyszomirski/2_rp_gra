@federation
title: Federation
subtitle: [? if pl_stance_federation_present = 1 : This is the present line. Confirming it costs this month's action and the card waits as after a change; nothing else changes. ?][? if pl_stance_federation_present = 0 : The programme of a federal state; axis +2. Only compatible steps can be carried out in this chapter. ?]
choose-if: {! return PolishParty.stanceStatus(Q, 'slavic_autonomy', 'federation').available !}
unavailable-subtitle: [+ pl_stance_federation_why +]
on-arrival: {!
PolishParty.stanceChoose(Q, 'slavic_autonomy', 'federation');
!}
go-to: result

