@kpp_line
title: Agree on the line of cooperation with the communists
subtitle: No money; acceptance of the cooperation +15 in each faction. Waits 6 months.
choose-if: {! return PolishParty.unityStatus(Q, 'kpp_line').available !}
unavailable-subtitle: [+ pl_unity_kpp_line_why +]
on-arrival: {!
PolishParty.unityChoose(Q, 'kpp_line');
!}
go-to: result

@postpone_centrum
title: Persuade Centrum PPS to wait
subtitle: Its case cannot lead to a split for 3 months; its dissent does not change. Once per case.
choose-if: {! return PolishParty.unityStatus(Q, 'postpone', 'centrum').available !}
unavailable-subtitle: [+ pl_unity_postpone_centrum_why +]
on-arrival: {!
PolishParty.unityChoose(Q, 'postpone', 'centrum');
!}
go-to: result

