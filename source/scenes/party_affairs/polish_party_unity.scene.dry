title: Unity and Leadership
subtitle: A concession, a common line on the communists, a postponement, or a purge.
new-page: true
is-card: true
tags: party_affairs
view-if: {! return !!Q.S && !!Q.polish_party_rules && PolishParty.unityAvailable(Q) !}
on-arrival: {!
// Card party.unity (technical reference 10.2, 10.5, 10.9, 9.5; card catalogue 6.3–6.4): in the pool only
// when a faction's dissent is 30 or more or the channel to the KPP is open. There is no plain "hold the line".
PolishParty.unityView(Q);
!}

= Unity and leadership

[+ pl_unity_centrum_line +]

[+ pl_unity_lewica_line +]

[+ pl_unity_pilsudczycy_line +]

- @concession_centrum
- @concession_lewica
- @concession_pilsudczycy
- @kpp_line
- @postpone_centrum
- @postpone_lewica
- @postpone_pilsudczycy
- @expel_centrum
- @expel_lewica
- @expel_pilsudczycy
- @easy_discard

@concession_centrum
title: A concession to Centrum PPS
subtitle: 1 R; its dissent −8. Waits 3 months for this faction.
choose-if: {! return PolishParty.unityStatus(Q, 'concession', 'centrum').available !}
unavailable-subtitle: [+ pl_unity_concession_centrum_why +]
on-arrival: {!
PolishParty.unityChoose(Q, 'concession', 'centrum');
!}
go-to: result

@concession_lewica
