title: Adviser action
on-arrival: {!
// Called with call: by every Polish adviser action. Records one adviser transaction: all advisers
// wait until t+6, and an action that opens a card makes that one step cost no month (technical
// reference 4.3-4.4). The action is final once chosen.
PolishRules.commitAdvisorAction(Q, this.state, this.game);
!}
