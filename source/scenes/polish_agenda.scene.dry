title: Agenda
subtitle: Prepared reforms wait here for their launch.
is-pinned-card: true
card-image: img/reichstag_1.jpg
view-if: {! return !!Q.S && PolishProjects.agendaAvailable(Q) !}
new-page: true
on-arrival: {!
// The agenda of prepared reforms (technical reference 12.2, 17.11): the next step of a prepared project
// needs no card from the hand and no renewal; it still costs this month's action (1 T) and needs its law,
// its financing and its executor. A new programme starts only at a forecast budget of −2 B or above (11.3).
PolishProjects.agendaView(Q);
!}

= The agenda

[+ pl_agenda_lines +]

[+ pl_agenda_budget +]

- @launch_public_works
- @launch_credit_instrument
- @launch_land_program
- @launch_agriculture_development
- @launch_education_program
- @launch_minority_schools
- @launch_heritage
- @launch_currency_reform
- @launch_plant_rescue
- @launch_enterprise_representation
- @launch_army_control
- @launch_limited_autonomy
- @submit_democratic_guarantees
- @submit_constructive_vonc
- @submit_presidential_arbitration
- @later

@launch_public_works
title: Launch the prepared public works
view-if: {! return PolishProjects.agendaItemsFor(Q).indexOf('public_works') >= 0 !}
choose-if: {! return PolishProjects.agendaStatus(Q, 'public_works').available !}
unavailable-subtitle: [+ pl_agenda_public_works_why +]
on-arrival: {!
PolishProjects.agendaChoose(Q, 'public_works');
!}
go-to: result

