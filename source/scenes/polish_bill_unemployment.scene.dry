choose-if: {! return PolishProjects.billFileStatus(Q, 'unemployment', 'limited').available !}
unavailable-subtitle: [+ pl_bill_limited_why +]
on-arrival: {!
Q.pl_ini_result = PolishProjects.billFile(Q, 'unemployment', 'limited');
!}
go-to: result

@result
