choose-if: {! return PolishGovernment.portfolioStatus(Q, 'finance').available !}
unavailable-subtitle: [+ pl_port_finance_why +]
on-arrival: {!
PolishGovernment.setDraft(Q, 'portfolio_take', 'finance');
!}
go-to: portfolio_menu

@drop_finance
title: Give up Treasury
subtitle: Returns 20 influence points.
view-if: pl_port_finance_held
on-arrival: {!
PolishGovernment.setDraft(Q, 'portfolio_drop', 'finance');
!}
go-to: portfolio_menu

