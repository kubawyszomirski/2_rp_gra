title: Cabinet Formation
subtitle: What is happening, then four steps: the variant of the cabinet with the role of PPS, the prime minister, the portfolios and the summary.
new-page: true
is-card: true
tags: parliament_affairs
card-image: img/polish/polish_cabinet_formation.jpg
view-if: {! return !!Q.S && PolishGovernment.formationVisible(Q) !}
on-arrival: {!
// Card parliament.cabinet_formation (technical reference 8.3, 8.4, 8.7, 8.8; card catalogue 7.1). Z — 0.71 (decisions 0 and
// 1A–5A of 7 X 2026): an introduction, then the steps one after another — the variant with the role of PPS, the prime
// minister, the portfolios and the summary, each with "Back"; a step with one possibility is skipped. Changing a setting
// is free; the commit on the summary decides. A mandatory formation costs no month; the player's own initiative costs one.
if (!Q.S) return;
// Every step only prepares the one offer, so closing the card from any step is free (Z — 0.71).
PolishRules.freeCardPages(Q, 'polish_cabinet_formation');
var neg = PolishGovernment.enterFormation(Q);
var intro = PolishGovernment.formationIntro(Q);
Q.pl_form_mandatory = neg.mandatory ? 1 : 0;
Q.pl_form_intro_why = intro.why;
Q.pl_form_intro_appoints = intro.appoints;
Q.pl_form_intro_sejm = intro.sejm;
Q.pl_form_intro_plan = intro.plan;
// Stage 8 (A1): the cause of a crisis opened by a dated input of the scenario.
Q.pl_form_cause = typeof PolishPolitics !== 'undefined' && PolishPolitics.crisisNote ? PolishPolitics.crisisNote(Q) : '';
Q.pl_form_cause_on = Q.pl_form_cause ? 1 : 0;
!}

= Forming a cabinet

[+ pl_form_intro_why +] [? if pl_form_cause_on : [+ pl_form_cause +] ?]

[+ pl_form_intro_appoints +]

[+ pl_form_intro_sejm +]

[+ pl_form_intro_plan +]

- @variants: Begin: choose the variant of the cabinet
- @easy_discard
- view-if: not pl_form_mandatory

@variants
new-page: true
on-arrival: {!
for (var id of PolishGovernment.PPS_CONFIGURATIONS) {
    Q['pl_cfg_' + id + '_line'] = PolishGovernment.coalitionLine(Q, id).line;
}
Q.pl_cfg_opposition_line = PolishGovernment.oppositionLine(Q);
Q.pl_form_majority = PolishGovernment.majorityRequired(Q.S);
!}

= The variant of the cabinet

Each variant says who forms the cabinet and what PPS does in it: in a party cabinet PPS sits with its ministers, a cabinet of experts PPS supports from outside, and in opposition PPS leaves the cabinet to the others. A majority needs [+ pl_form_majority +] MPs; a minority cabinet needs more votes for than against. A variant that is not possible now is greyed with the reason.

- @var_left_minority
- @var_centre_left
- @var_left_labour
- @var_pps_majority
- @var_broad_centre
- @var_skrzynski_broad
- @var_national_unity
- @var_united_left
- @var_workers_front
- @var_expert
- @var_opposition
- @back_intro

@var_left_minority
title: In the cabinet: PPS and PSL Wyzwolenie
subtitle: [+ pl_cfg_left_minority_line +]
choose-if: {! return PolishGovernment.variantStatus(Q, 'left_minority').available !}
unavailable-subtitle: [+ pl_cfg_left_minority_line +]
on-arrival: {!
PolishGovernment.chooseVariant(Q, 'left_minority');
var st = PolishGovernment.formationSteps(Q);
Q.pl_form_need_premier = st.premier ? 1 : 0;
Q.pl_form_need_ports = st.portfolios ? 1 : 0;
!}
go-to: premier if pl_form_need_premier; portfolio_menu if pl_form_need_ports and not pl_form_need_premier; summary if not pl_form_need_premier and not pl_form_need_ports

