title: A Financial Crisis
subtitle: The marka collapses and the budget has no cover.
new-page: true
tags: pl_event
face-image: img/polish/polish_event_stabilization.jpg
view-if: {! return !!Q.S && PolishProjects.stabilizationEventDue(Q) !}
on-arrival: {!
// Event economy.stabilization (technical reference 17.3, 17.13 B14, 11.9; card catalogue 9.11): a financial crisis without a
// currency reform, once. Z — 1.04 (decision 4A of the event audit, 7 XI 2026): with the Treasury PPS chooses the reform here
// (the answer costs no action; the reform pays its price from the pool) or postpones it to the card "Currency Stabilisation";
// without the Treasury the party answers with the campaign against high prices for 1 R or leaves the reform to the cabinet.
Q.pl_ev_treasury = PolishProjects.ppsHolds(Q.S, 'finance') ? 1 : 0;
Q.pl_ev_currency = PolishEconomy.currencyCrisis(Q.S.economy) ? 1 : 0;
Q.pl_ev_strong = PolishParty.issueSituation(Q, 'prices') ? 1 : 0;
PolishProjects.costWords(Q);
for (var option of ['rapid_cuts', 'protected', 'gradual', 'campaign']) {
    Q['pl_ev_' + option + '_why'] = PolishProjects.eventStatus(Q, 'stabilization', option).reason;
}
!}

= A financial crisis

[? if pl_ev_currency : The marka loses value from day to day, and prices rise faster than wages. The budget has no cover, and without a currency reform it will only get worse. ?]

[? if not pl_ev_currency : The budget has had no cover for months, and the state lives on the printing press. Without a currency reform it will only get worse. ?]

- @rapid_cuts
- @protected
- @gradual
- @postpone
- @campaign
- @wait

@rapid_cuts
title: Rapid stabilisation with savings
subtitle: The złoty comes after three months ([+ pl_cost3 +]), but the cuts and the lack of credit will hit the factories.
view-if: pl_ev_treasury
choose-if: {! return PolishProjects.eventStatus(Q, 'stabilization', 'rapid_cuts').available !}
unavailable-subtitle: [+ pl_ev_rapid_cuts_why +]
on-arrival: {!
PolishProjects.eventChoose(Q, 'stabilization', 'rapid_cuts');
!}
go-to: result

@protected
title: Stabilisation with protection for the unemployed and a tax on wealth
subtitle: The złoty comes after three months ([+ pl_cost3 +]); it needs a working protection for the unemployed.
view-if: pl_ev_treasury
choose-if: {! return PolishProjects.eventStatus(Q, 'stabilization', 'protected').available !}
unavailable-subtitle: [+ pl_ev_protected_why +]
on-arrival: {!
PolishProjects.eventChoose(Q, 'stabilization', 'protected');
!}
go-to: result

@gradual
title: Gradual limitation of emission
subtitle: Cheaper ([+ pl_cost2 +]), but the złoty comes only after five months.
view-if: pl_ev_treasury
choose-if: {! return PolishProjects.eventStatus(Q, 'stabilization', 'gradual').available !}
unavailable-subtitle: [+ pl_ev_gradual_why +]
on-arrival: {!
PolishProjects.eventChoose(Q, 'stabilization', 'gradual');
!}
go-to: result

@postpone
title: Postpone the reform
subtitle: No cost now; the reform can be started later with the card “Currency Stabilisation”.
view-if: pl_ev_treasury
on-arrival: {!
PolishProjects.eventChoose(Q, 'stabilization', 'postpone');
!}
go-to: result

@campaign
title: Start the campaign “Against high prices”
subtitle: Costs 1 resource. It reaches the workers and the intelligentsia[? if pl_ev_strong : , and in this crisis more strongly than usual ?].
view-if: not pl_ev_treasury
choose-if: {! return PolishProjects.eventStatus(Q, 'stabilization', 'campaign').available !}
unavailable-subtitle: [+ pl_ev_campaign_why +]
on-arrival: {!
PolishProjects.eventChoose(Q, 'stabilization', 'campaign');
!}
go-to: result

@wait
title: Leave the reform to the cabinet
subtitle: No cost; the cabinet will prepare the reform itself.
view-if: not pl_ev_treasury
on-arrival: {!
PolishProjects.eventChoose(Q, 'stabilization', 'wait');
!}
go-to: result

@result
new-page: true

= A financial crisis

[+ pl_gc_result +]

- @root: Continue.
