@course_social_reform
title: Preparation of a social reform (level 2)
subtitle: A large labour, education, housing or cooperative project not yet launched: full preparation and one month shorter, once.
choose-if: {! return PolishParty.courseStatus(Q, 'social_reform').available !}
unavailable-subtitle: [+ pl_pa_course_social_reform_why +]
on-arrival: {!
PolishParty.turCourse(Q, 'social_reform');
!}
go-to: result

@course_national_education
title: A national education campaign (level 3)
subtitle: As the civil rights course, among the workers, the peasants and the intelligentsia.
choose-if: {! return PolishParty.courseStatus(Q, 'national_education').available !}
unavailable-subtitle: [+ pl_pa_course_national_education_why +]
on-arrival: {!
PolishParty.turCourse(Q, 'national_education', 'workers,rural,new_middle');
!}
go-to: result

@launch_cooperative
title: Launch the prepared cooperative
subtitle: 1 T, 2 R: [+ pl_pa_coop_name +] starts work; upkeep 0.10 R a month.
view-if: pl_pa_coop_count > 0
choose-if: {! return PolishParty.cooperativeStatus(Q, Q.pl_pa_coop_id).available !}
unavailable-subtitle: [+ pl_pa_coop_why +]
on-arrival: {!
PolishParty.launchCooperative(Q, Q.pl_pa_coop_id);
!}
go-to: result

@kpp_trial
title: Cooperation with the KPP: agree on a trial
subtitle: 1 T; a trial of joint action for an existing demand, at a relation of 30 or more. Relation now [+ pl_kpp_relation +].
view-if: pl_pa_kpp_open = 1
choose-if: {! return PolishParty.kppStepStatus(Q, 'trial').available !}
unavailable-subtitle: [+ pl_kpp_trial_why +]
on-arrival: {!
PolishParty.kppStep(Q, 'trial');
!}
go-to: result

@kpp_rules
title: Cooperation with the KPP: agree on the rules
subtitle: 1 T; after two different successful joint actions, one of them full, at a relation of 50 or more.
view-if: pl_pa_kpp_open = 1
choose-if: {! return PolishParty.kppStepStatus(Q, 'rules').available !}
unavailable-subtitle: [+ pl_kpp_rules_why +]
on-arrival: {!
PolishParty.kppStep(Q, 'rules');
!}
go-to: result

@kpp_agreement
title: Cooperation with the KPP: a broader agreement
subtitle: 1 T, 1 R; needs rules accepted by both sides and the acceptance of 60 inside PPS (now [+ pl_kpp_acceptance +]).
view-if: pl_pa_kpp_open = 1
choose-if: {! return PolishParty.kppStepStatus(Q, 'agreement').available !}
unavailable-subtitle: [+ pl_kpp_agreement_why +]
on-arrival: {!
PolishParty.kppStep(Q, 'agreement');
!}
go-to: result

@assess_forces
title: Assess the forces of the state
subtitle: 1 R; the interval of the known loyalty of the army groups narrows by 10 pp, to ±5 at best; waits 3 months. The loyalties themselves do not change.
view-if: {! return !!Q.polish_security_rules && PolishSecurity.ready(Q) !}
choose-if: {! return PolishSecurity.assessStatus(Q).available !}
unavailable-subtitle: [+ pl_pa_assess_why +]
on-arrival: {!
PolishSecurity.assess(Q);
Q.pl_party_result = Q.pl_security_result;
!}
go-to: result

@later
title: Not now
subtitle: Nothing is spent.
go-to: main

@result
new-page: true

= The party agenda

[+ pl_party_result +]

- @root: Continue.
