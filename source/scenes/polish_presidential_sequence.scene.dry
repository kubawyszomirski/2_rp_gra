title: Wybory Prezydenta Rzeczypospolitej
new-page: true
call: polish_opening_state
on-arrival: {!
// Mandatory December sequence (technical reference 7.3; card 7.9): nomination choice → final
// result → oath. It never advances the month and resumes from its saved phase. The National
// Assembly is the recorded Sejm plus the recorded 111-seat Senate (sejm_proxy_v1). Results are
// counted from the clubs' votes with the approved test profile, not fixed historical ballots.
function copy(value) { return JSON.parse(JSON.stringify(value)); }
if (Q.polish_presidential_system && Q.polish_presidential_due &&
        !Q.polish_presidential_pending && !Q.polish_presidential_sequence_completed) {
    var S = Q.S;
    var sejm = Q.sejm_parliament;
    var senateSeats = copy(S.senate.club_seats);
    // Stage 8 (a gap of stage 5): the Assembly counts the Sejm clubs as they sit in December, so MPs who left PPS
    // with a faction before it met no longer count as PPS; their technical splinter club has no presidential profile.
    var sejmSeats = {};
    var clubs = S.parliament && S.parliament.clubs ? S.parliament.clubs : null;
    for (var party of Q.parties) {
        if (!clubs) { sejmSeats[party] = sejm.party_seats[party] || 0; continue; }
        var ids = party === 'minorities_bloc' ? ['jewish_rep', 'other_minorities_rep', 'minorities_bloc'] : [party];
        sejmSeats[party] = clubs.filter(function (club) { return ids.indexOf(club.id) >= 0; })
            .reduce(function (n, club) { return n + club.seats; }, 0);
    }
    var assemblySeats = {};
    for (var party of Q.parties) {
        assemblySeats[party] = (sejmSeats[party] || 0) + (senateSeats[party] || 0);
    }
    var assembly = {
        id: 'national_assembly_1922_12',
        kind: 'gameplay_proportional_senate_snapshot',
        method: S.senate.method,
        sejm_total: sejm.total_seats,
        senate_total: S.senate.total,
        total_members: sejm.total_seats + S.senate.total,
        sejm_seats: copy(sejmSeats),
        senate_seats: senateSeats,
        party_seats: assemblySeats,
        party_names: copy(Q.party_names)
    };
    Q.polish_presidency.assembly = copy(assembly);
    Q.polish_presidential_pending = {
        id: 'presidential_december_1922',
        phase: 'first_nomination',
        assembly: copy(assembly),
        first_pps_candidate: null,
        second_pps_candidate: null,
        assassination_response: null,
        waiting_until: null
    };
    Q.polish_presidential_phase = 'first_nomination';
}
// Display fields of the recorded runs.
var pending = Q.polish_presidential_pending;
Q.pl_daszynski_available = Q.daszynski_left_adviser_pool ? 0 : 1;
function describe(prefix, id) {
    var run = Q.polish_presidency.elections.filter(function(item) { return item.id === id; })[0];
    Q[prefix + '_recorded'] = run ? 1 : 0;
    if (!run) return;
    Q[prefix + '_lines'] = run.final_ballot.map(function(row) {
        return row.candidate_name + ' — ' + row.votes + ' votes';
    }).join('; ') + '; blank ballots — ' + run.blank_ballots;
    Q[prefix + '_winner'] = run.winner_name || '';
    Q[prefix + '_status'] = run.status;
    Q[prefix + '_tie'] = run.tie_break ? 1 : 0;
    Q[prefix + '_rounds'] = run.rounds.length;
    // Z — 0.57 (item 9 of the play notes of 5 X 2026): more than two candidates in the decisive ballot means a majority won
    // outright; the screen explains it.
    Q[prefix + '_outright'] = run.final_ballot.length > 2 ? 1 : 0;
    Q[prefix + '_nominee'] = run.pps_nomination ? 'Ignacy Daszyński' : 'no PPS candidate';
}
describe('pl_pres_first', 'president_1922_12_09');
describe('pl_pres_second', 'president_1922_12_20');
Q.pl_pres_waiting = pending && pending.waiting_until && pending.waiting_until > Q.time ? 1 : 0;
!}
go-to: first_nomination if polish_presidential_phase = "first_nomination" and not pl_pres_waiting; first_final if polish_presidential_phase = "first_final"; first_transfer if polish_presidential_phase = "first_transfer"; assassination if polish_presidential_phase = "assassination"; second_nomination if polish_presidential_phase = "second_nomination" and not pl_pres_waiting; second_final if polish_presidential_phase = "second_final"; main if polish_presidential_phase = "" or polish_presidential_phase = "complete" or pl_pres_waiting

@first_nomination
new-page: true

= Zgromadzenie Narodowe — 9 December 1922

The first President of the Republic is elected by the **National Assembly**: the 444-member Sejm together with the 111 senators recorded after the Sejm election. The Senate follows the Sejm party proportions; it is a simplification, not a separate campaign.

The candidates of the other groups are **Maurycy Zamoyski** for the right, **Stanisław Wojciechowski** for PSL Piast, **Jan Baudouin de Courtenay** for the national minorities and **Gabriel Narutowicz** for PSL Wyzwolenie. PPS decides whether to nominate **Ignacy Daszyński**.

The game shows only the final result. Each club votes for its preferred candidate still standing; the weakest candidate drops out until one has more than half of the valid votes, or the larger vote wins a final between two. Baudouin de Courtenay is the symbolic candidate of the minorities: after the first round he withdraws and they vote for their next choice, as in 1922. A tie between two finalists is decided by a recorded lot. The clubs' preferences are an approved test profile, not a reconstruction of the historical ballots.

- @confirm_daszynski: Nominate Ignacy Daszyński as the PPS candidate.
- @decline_daszynski: Do not nominate a PPS candidate.

@confirm_daszynski
choose-if: pl_daszynski_available
unavailable-subtitle: Ignacy Daszyński has left PPS through the Centrum crisis, so the party cannot nominate him.
on-arrival: {!
if (Q.polish_presidential_pending && Q.polish_presidential_pending.phase === 'first_nomination') {
    Q.polish_presidential_pending.first_pps_candidate = 'ignacy_daszynski';
    Q.polish_presidency.pps_decisions.push({
        id: 'first_presidential_nomination_1922', date: '1922-12-09',
        decision: 'nominate_ignacy_daszynski', active_adviser_slot_required: false
    });
}
!}
go-to: first_vote

@decline_daszynski
on-arrival: {!
if (Q.polish_presidential_pending && Q.polish_presidential_pending.phase === 'first_nomination') {
    Q.polish_presidential_pending.first_pps_candidate = '';
    Q.polish_presidency.pps_decisions.push({
        id: 'first_presidential_nomination_1922', date: '1922-12-09',
        decision: Q.daszynski_left_adviser_pool ? 'no_pps_candidate_after_daszynski_departure' : 'no_pps_candidate',
        active_adviser_slot_required: false
    });
}
!}
go-to: first_vote

@first_vote
on-arrival: {!
// The count, once per run; a vote that does not resolve leaves the Naczelnik in office and repeats
// next month (M06).
var pending = Q.polish_presidential_pending;
if (pending && pending.phase === 'first_nomination') {
    var id = 'president_1922_12_09';
    var run = PolishInstitutions.resolvePresidentialElection(Q, id, 'president_first', pending.first_pps_candidate === 'ignacy_daszynski');
    var record = {
        id: id, date: '1922-12-09', body: 'national_assembly', method: 'presidential_final_result_v1',
        assembly_id: pending.assembly.id, assembly_snapshot: run.electorate,
        pps_candidate: pending.first_pps_candidate, pps_nomination: run.pps_nomination,
        preference_snapshot: run.preference_snapshot, profile_id: run.profile_id, rounds: run.rounds,
        final_ballot: run.final_ballot ? run.final_ballot.candidates : [],
        blank_ballots: run.final_ballot ? run.final_ballot.abstain : 0, invalid_ballots: 0,
        present: run.present, quorum: run.quorum,
        winner_id: run.winner_id || '', winner_name: run.winner_name || '',
        status: run.status, reason: run.reason, tie_break: run.tie_break, effects_applied: []
    };
    PolishInstitutions.recordOfficeBallot(Q.S, run, record.date);
    if (run.status === 'elected') {
        Q.polish_presidency.elections.push(record);
        pending.phase = 'first_final';
    } else {
        Q.polish_presidency.failed_elections = (Q.polish_presidency.failed_elections || []).concat([record]);
        pending.waiting_until = Q.time + 1;
        pending.first_pps_candidate = null;
    }
    Q.polish_presidential_phase = pending.phase;
}
!}
go-to: polish_presidential_sequence

@first_final
new-page: true

= Final result — 9 December 1922

**[+ pl_pres_first_winner +] is elected President of the Republic.**

Decisive ballot (round [+ pl_pres_first_rounds +]): [+ pl_pres_first_lines +].

[? if pl_pres_first_outright : The winner had more than half of the valid ballots (blank ones included) in this round, so the election ended without a further round; a final between two is held only when no candidate has such a majority. ?]

[? if pl_pres_first_tie : The two finalists received the same number of votes; the office was decided by a recorded lot. ?]

PPS nomination: [+ pl_pres_first_nominee +]. The count took [+ pl_pres_first_rounds +] rounds; only the final is shown. The result is recorded once and does not change after a save and load.

- @first_transfer: Continue to the oath.

@first_transfer
new-page: true
on-arrival: {!
var pending = Q.polish_presidential_pending;
if (pending && pending.phase === 'first_final') {
    var election = Q.polish_presidency.elections.filter(function(item) { return item.id === 'president_1922_12_09'; })[0];
    var short = election.winner_id.split('_').slice(1).join('_');
    if (!Q.polish_presidency.transitions.some(function(item) { return item.id === short + '_oath'; })) {
        Q.polish_presidency.transitions.push({
            id: short + '_oath', date: '1922-12-11', kind: 'presidential_oath',
            office_id: 'prezydent_rp', holder_id: election.winner_id, holder_name: election.winner_name
        });
        Q.polish_presidency.transitions.push({
            id: 'pilsudski_transfer', date: '1922-12-14', kind: 'transfer_from_naczelnik_panstwa',
            from_holder_id: 'jozef_pilsudski', to_holder_id: election.winner_id
        });
    }
    Q.polish_presidency.current = {
        office_id: 'prezydent_rp', holder_id: election.winner_id,
        holder_name: election.winner_name, status: 'incumbent', since: '1922-12-11'
    };
    Q.head_of_state_office = 'prezydent_rp';
    Q.head_of_state_name = election.winner_name;
    // A Marshal elected President leaves the Marshal's office and the Sejm (7.3).
    PolishInstitutions.vacateSpeakerForPresidency(Q, election.winner_id, '1922-12-11');
    // The historical threat branch reads who was elected; it does not follow any left winner (17.16).
    pending.phase = election.winner_id === 'gabriel_narutowicz' ? 'assassination' : 'complete';
    Q.polish_presidential_phase = pending.phase;
    if (pending.phase === 'complete') Q.polish_presidential_sequence_completed = 1;
}
!}

= The presidency begins

[+ pl_pres_first_winner +] takes the constitutional oath on 11 December. On 14 December, Józef Piłsudski formally transfers state authority to the President, ending the transitional office of Naczelnik Państwa.

The presidency is governed by the March Constitution. Government acts require ministerial countersignature; the President appoints the prime minister and appoints ministers on the prime minister's proposal. The office does not inherit the German president's direct-popular mandate, independent emergency-decree model or legacy game powers.

- @assassination: Continue to 16 December.
- @first_done: Resume December play.

@first_done
view-if: polish_presidential_phase = "complete"
go-to: root

@assassination
view-if: polish_presidential_phase = "assassination"
new-page: true
on-arrival: {!
var pending = Q.polish_presidential_pending;
if (pending && pending.phase === 'assassination') {
    if (!Q.polish_presidency.transitions.some(function(item) { return item.id === 'narutowicz_assassinated'; })) {
        Q.polish_presidency.transitions.push({
            id: 'narutowicz_assassinated', date: '1922-12-16', kind: 'assassination',
            holder_id: 'gabriel_narutowicz', holder_name: 'Gabriel Narutowicz'
        });
    }
    // B3 (presidency.security_crisis; technical reference 17.13; decision 2B of stage 7): the threat settles without a
    // menu; the protection of the President is not modelled in this chapter. The death is one case of violence
    // against institutions and the answer of PPS (B4) follows in the event queue, after the vacancy below.
    if (Q.polish_politics_rules) {
        PolishPolitics.securityCrisis(Q, {holder_id: 'gabriel_narutowicz', holder_name: 'Gabriel Narutowicz', date: '1922-12-16',
            perpetrator: 'Eligiusz Niewiadomski'});
    }
    // C9: the Marshal of the Sejm substitutes for the vacant presidency, without a separate scene.
    var speaker = Q.S.parliament.speaker;
    if (speaker && !Q.polish_presidency.transitions.some(function(item) { return item.kind === 'acting_presidency' && item.date === '1922-12-16'; })) {
        Q.polish_presidency.transitions.push({
            id: speaker.person_id.split('_').slice(1).join('_') + '_acting', date: '1922-12-16', kind: 'acting_presidency',
            holder_id: speaker.person_id, holder_name: speaker.name, reason: 'vacancy_after_assassination',
            basis: 'march_constitution_1921_marshal_substitutes'
        });
    }
    Q.polish_presidency.current = speaker ? {
        office_id: 'prezydent_rp', holder_id: speaker.person_id, holder_name: speaker.name,
        status: 'acting', since: '1922-12-16'
    } : {
        office_id: 'prezydent_rp', holder_id: '', holder_name: 'Vacant', status: 'vacant', since: '1922-12-16'
    };
    Q.head_of_state_office = 'prezydent_rp';
    Q.head_of_state_name = Q.polish_presidency.current.holder_name;
    pending.phase = 'second_nomination';
    Q.polish_presidential_phase = 'second_nomination';
}
var current = Q.polish_presidency.current;
Q.pl_acting_president = current.status === 'acting' ? current.holder_name : '';
!}

= The assassination of Gabriel Narutowicz

On 16 December, Gabriel Narutowicz is assassinated at the Zachęta gallery by Eligiusz Niewiadomski after a campaign of nationalist hostility against the elected President.

[? if pl_acting_president : As Marshal of the Sejm, [+ pl_acting_president +] substitutes for the President until the National Assembly elects a successor. ?]

The protection of the President is not modelled in this chapter: the threat is settled without a separate choice. PPS now answers the assassination; the National Assembly then meets again to elect a successor.

- @root: Continue.

@second_nomination
new-page: true

= The second election — 20 December 1922

The National Assembly reconvenes. **Stanisław Wojciechowski**, supported by PSL Piast, faces **Kazimierz Morawski**, the candidate of the right. PPS decides whether to nominate Ignacy Daszyński. As before, the clubs' votes decide the result and only the final is shown.

- @do_not_run_daszynski_second: Do not nominate a PPS candidate.
- @run_daszynski_second: Nominate Ignacy Daszyński as the PPS candidate.

@do_not_run_daszynski_second
on-arrival: {!
if (Q.polish_presidential_pending && Q.polish_presidential_pending.phase === 'second_nomination') {
    Q.polish_presidential_pending.second_pps_candidate = '';
    Q.polish_presidency.pps_decisions.push({
        id: 'second_presidential_nomination_1922', date: '1922-12-20',
        decision: 'no_pps_candidate', active_adviser_slot_required: false
    });
}
!}
go-to: second_vote

@run_daszynski_second
choose-if: pl_daszynski_available
unavailable-subtitle: Ignacy Daszyński has left PPS through the Centrum crisis, so the party cannot nominate him.
on-arrival: {!
if (Q.polish_presidential_pending && Q.polish_presidential_pending.phase === 'second_nomination') {
    Q.polish_presidential_pending.second_pps_candidate = 'ignacy_daszynski';
    Q.polish_presidency.pps_decisions.push({
        id: 'second_presidential_nomination_1922', date: '1922-12-20',
        decision: 'nominate_ignacy_daszynski', active_adviser_slot_required: false
    });
}
!}
go-to: second_vote

@second_vote
on-arrival: {!
var pending = Q.polish_presidential_pending;
if (pending && pending.phase === 'second_nomination') {
    var id = 'president_1922_12_20';
    var run = PolishInstitutions.resolvePresidentialElection(Q, id, 'president_second', pending.second_pps_candidate === 'ignacy_daszynski');
    var record = {
        id: id, date: '1922-12-20', body: 'national_assembly', method: 'presidential_final_result_v1',
        assembly_id: pending.assembly.id, assembly_snapshot: run.electorate,
        pps_candidate: pending.second_pps_candidate, pps_nomination: run.pps_nomination,
        preference_snapshot: run.preference_snapshot, profile_id: run.profile_id, rounds: run.rounds,
        final_ballot: run.final_ballot ? run.final_ballot.candidates : [],
        blank_ballots: run.final_ballot ? run.final_ballot.abstain : 0, invalid_ballots: 0,
        present: run.present, quorum: run.quorum,
        winner_id: run.winner_id || '', winner_name: run.winner_name || '',
        status: run.status, reason: run.reason, tie_break: run.tie_break, effects_applied: []
    };
    PolishInstitutions.recordOfficeBallot(Q.S, run, record.date);
    if (run.status === 'elected') {
        Q.polish_presidency.elections.push(record);
        var short = run.winner_id.split('_').slice(1).join('_');
        if (!Q.polish_presidency.transitions.some(function(item) { return item.id === short + '_oath'; })) {
            Q.polish_presidency.transitions.push({
                id: short + '_oath', date: '1922-12-20', kind: 'presidential_oath_and_assumption',
                office_id: 'prezydent_rp', holder_id: run.winner_id, holder_name: run.winner_name
            });
        }
        Q.polish_presidency.current = {
            office_id: 'prezydent_rp', holder_id: run.winner_id,
            holder_name: run.winner_name, status: 'incumbent', since: '1922-12-20'
        };
        Q.head_of_state_office = 'prezydent_rp';
        Q.head_of_state_name = run.winner_name;
        PolishInstitutions.vacateSpeakerForPresidency(Q, run.winner_id, '1922-12-20');
        // The lawful successor has taken the oath: the case of the assassination is no longer an emergency (8.8).
        if (Q.polish_politics_rules) PolishPolitics.successionCompleted(Q, 'gabriel_narutowicz');
        pending.phase = 'second_final';
    } else {
        // The acting Marshal stays; the vote repeats next month (M06).
        Q.polish_presidency.failed_elections = (Q.polish_presidency.failed_elections || []).concat([record]);
        pending.waiting_until = Q.time + 1;
        pending.second_pps_candidate = null;
    }
    Q.polish_presidential_phase = pending.phase;
}
!}
go-to: polish_presidential_sequence

@second_final
new-page: true
on-arrival: {!
var pending = Q.polish_presidential_pending;
if (pending && pending.phase === 'second_final') {
    pending.phase = 'complete';
    Q.polish_presidential_phase = 'complete';
    Q.polish_presidential_sequence_completed = 1;
}
!}

= Final result — 20 December 1922

**[+ pl_pres_second_winner +] is elected and assumes the office of President of the Republic.**

Decisive ballot (round [+ pl_pres_second_rounds +]): [+ pl_pres_second_lines +].

[? if pl_pres_second_outright : The winner had more than half of the valid ballots (blank ones included) in this round, so the election ended without a further round; a final between two is held only when no candidate has such a majority. ?]

[? if pl_pres_second_tie : The two finalists received the same number of votes; the office was decided by a recorded lot. ?]

PPS nomination: [+ pl_pres_second_nominee +]. The current government and all nine portfolio assignments remain unchanged: electing a President does not change the cabinet.

- @finish: Resume December play.

@finish
go-to: root

The presidential results and PPS decisions are now part of the permanent game history. No monthly action has been spent.
