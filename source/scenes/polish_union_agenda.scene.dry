= [+ pl_un_branch_name +]

[+ pl_un_branch_text +]

[? if pl_un_offer : [+ pl_un_offer +] PPS answers it in the Sejm. ?]

- @prepare_limited
- @prepare_broad
- @align_strike
- @align_end
- @mediate
