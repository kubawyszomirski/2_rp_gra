title: Post Event
new-page: true
call: polish_opening_state
on-arrival: {!
// Save compatibility (technical reference 19.3, Z — 0.40): a save without the current
// state schema stops here instead of continuing with old state.
if (typeof PolishRules === 'undefined' || !PolishRules.isSaveCompatible(Q)) {
    Q.polish_save_incompatible = 1;
    return;
}
// After the end of the chapter nothing more is settled: no new month, cost, loss or event (19.2).
if (Q.S.chapter.status === 'ended') {
    Q.has_event = 0;
    return;
}
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// Since stage 5 the cells of the electorate own the preferences: changes an inherited scene still wrote
// to a class row are taken over by the cells of that row, and the rows are written back from the cells
// (technical reference 5.2; decision 1A of stage 5).
if (Q.polish_party_rules) {
    PolishElectorate.absorbRowEdits(Q);
}
// Transfer inherited support effects into the semantic Polish party IDs.
for (var legacy_party in Q.legacy_party_map) {
    if (Q.polish_party_rules) break;
    var polish_party = Q.legacy_party_map[legacy_party];
    for (var population_group of Q.classes) {
        var legacy_key = population_group + '_' + legacy_party;
        var base_key = legacy_key + '_compat_base';
        var polish_key = population_group + '_' + polish_party;
        var legacy_delta = Q[legacy_key] - Q[base_key];
        if (Number.isFinite(legacy_delta) && legacy_delta != 0) {
            Q[polish_key] += legacy_delta;
        }
        Q[legacy_key] = Q[polish_key];
        Q[base_key] = Q[polish_key];
    }
}
var catholic_delta = Q.catholics_spd - Q.catholics_spd_compat_base;
if (!Q.polish_party_rules && Number.isFinite(catholic_delta) && catholic_delta != 0) {
    Q.national_minorities_pps += catholic_delta;
}
Q.catholics_spd = Q.national_minorities_pps;
Q.catholics_spd_compat_base = Q.catholics_spd;

// Transfer changes from inherited Reichsbanner calculations into the one
// canonical PPS self-defence organization. Direct Milicja/AS actions already
// write the semantic fields, so only the legacy deltas are added here.
var legacy_militia_strength_delta = Q.polish_party_rules ? 0 : Q.rb_strength - Q.rb_strength_compat_base;
var legacy_militia_militancy_delta = Q.polish_party_rules ? 0 : Q.rb_militancy - Q.rb_militancy_compat_base;
if (Number.isFinite(legacy_militia_strength_delta) && legacy_militia_strength_delta != 0) {
    Q.pps_militia_strength += legacy_militia_strength_delta;
}
if (Number.isFinite(legacy_militia_militancy_delta) && legacy_militia_militancy_delta != 0) {
    Q.pps_militia_militancy += legacy_militia_militancy_delta;
}
if (Q.pps_militia_strength < 0) {
    Q.pps_militia_strength = 0;
}
if (Q.pps_militia_militancy < 0) {
    Q.pps_militia_militancy = 0;
}
Q.rb_strength = Q.pps_militia_strength;
Q.rb_militancy = Q.pps_militia_militancy;
Q.rb_strength_compat_base = Q.rb_strength;
Q.rb_militancy_compat_base = Q.rb_militancy;
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

Q.pro_republic = Math.round(Q.pro_republic);
Q.nationalism = Math.round(Q.nationalism);
Q.socialism = Math.round(Q.socialism);

if (Q.pro_republic < 0) {
    Q.pro_republic = 0;
}
if (Q.pro_republic >= 100) {
    Q.pro_republic = 99;
}
// re-calculate party support
// calculate normalized class voting for the achievements. The same calculation runs again after the
// month's settlement, because the living-conditions flow (5.6) changes the class rows.
// Z — 0.56: the calculation lives in PolishElectorate.recomputeSupport, so that the opening can call it too.
function recomputeSupport() {
    PolishElectorate.recomputeSupport(Q);
}
recomputeSupport();


// Transfer inherited German faction changes into the active PPS faction
// model. This is a temporary gameplay bridge, not a historical equivalence.
// Labor remains a separate affiliated trade-union power centre.
for (var legacy_faction in Q.legacy_faction_map) {
    // Stage 5: the German factions no longer feed the PPS factions in the Polish game (10.1).
    if (Q.polish_party_rules) break;
    var pps_faction = Q.legacy_faction_map[legacy_faction];
    var legacy_strength_key = legacy_faction + '_strength';
    var legacy_dissent_key = legacy_faction + '_dissent';
    var strength_base_key = legacy_strength_key + '_compat_base';
    var dissent_base_key = legacy_dissent_key + '_compat_base';
    var strength_delta = Q[legacy_strength_key] - Q[strength_base_key];
    var dissent_delta = Q[legacy_dissent_key] - Q[dissent_base_key];
    if (Number.isFinite(strength_delta) && strength_delta != 0) {
        Q[pps_faction + '_strength'] += strength_delta;
    }
    if (Number.isFinite(dissent_delta) && dissent_delta != 0) {
        Q[pps_faction + '_dissent'] += dissent_delta;
    }
}

// Preserve the inherited five-field balance for conditions in unadapted
// cards, then store a new compatibility baseline so normalization is not
// transferred into the PPS factions as a fresh political change.
var legacy_total_strength = 0;
for (var legacy_faction of Q.legacy_factions) {
    if (Q[legacy_faction + '_dissent'] < 0) {
        Q[legacy_faction + '_dissent'] = 0;
    } else if (Q[legacy_faction + '_dissent'] >= 100) {
        Q[legacy_faction + '_dissent'] = 99;
    }
    if (Q[legacy_faction + '_strength'] < 0) {
        Q[legacy_faction + '_strength'] = 0;
    }
    legacy_total_strength += Q[legacy_faction + '_strength'];
}
if (legacy_total_strength > 0) {
    for (var legacy_faction of Q.legacy_factions) {
        Q[legacy_faction + '_strength'] = 100 * Q[legacy_faction + '_strength'] / legacy_total_strength;
    }
}
for (var legacy_faction of Q.legacy_factions) {
    Q[legacy_faction + '_strength_compat_base'] = Q[legacy_faction + '_strength'];
    Q[legacy_faction + '_dissent_compat_base'] = Q[legacy_faction + '_dissent'];
}

// Stage 5: the factions have their owner in Q.S (10.1); the inherited changes above are taken over and
// the mirrors, with the party's dissent, are written from the owner.
if (Q.polish_party_rules) {
    PolishParty.syncMirrors(Q);
}
// Clamp and normalize the three active PPS factions.
var total_strength = 0;
for (var faction of Q.factions) {
    if (Q[faction + '_dissent'] < 0) {
        Q[faction + '_dissent'] = 0;
    } else if (Q[faction + '_dissent'] >= 100) {
        Q[faction + '_dissent'] = 99;
    }
    if (Q[faction + '_strength'] < 0) {
        Q[faction + '_strength'] = 0;
    }
    total_strength += Q[faction + '_strength'];
}
if (total_strength > 0) {
    for (var faction of Q.factions) {
        Q[faction + '_strength'] = 100 * Q[faction + '_strength'] / total_strength;
    }
}

if (Q.unemployed <= 1) {
    Q.unemployed = 1;
}

// Recalculate overall party dissent from the three active PPS factions only.
// The separate Labor power centre retains its own dissent but is excluded.
var total_dissent = 0;
for (var faction of Q.factions) {
    total_dissent += Q[faction + '_strength'] * Q[faction + '_dissent'];
}
Q.dissent = total_strength > 0 ? 0.01 * total_dissent / 100 : 0;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

// 1. One month is settled once (technical reference 4.1-4.2). The rules module moves the clock and
// waives the month of a card opened by an adviser. Since stage 4 the Polish settlement of period t
// runs in the order of 4.2 (PolishProjects.settleMonth): laws, scenario effects, the cabinet's
// initiative, finances and projects, the economy, the living-conditions flow and promises; the
// inherited German economy below is off in the Polish game (leaks 1 and 9 of 20.2).
var settlement = PolishRules.beginMonthSettlement(Q, this.state);
if (settlement) {
    if (Q.month == 1 && Q.historical_mode) {
        Q.resources += 2;
    }
    // decrement timers
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    // Deterministic PPS adviser-pool departures. April 1927 is explicit in
    // the approved schedule. Daszyński's year-only 1931 departure is applied
    // at the beginning of that year until a more precise month is approved.
    if (!Q.perl_left_adviser_pool && (Q.year > 1927 || (Q.year == 1927 && Q.month >= 4))) {
        if (Q.perl_advisor) {
            Q.perl_advisor = 0;
            Q.n_advisors -= 1;
        }
        Q.perl_left_adviser_pool = 1;
    }
    if (!Q.daszynski_left_adviser_pool && Q.year >= 1931) {
        if (Q.daszynski_advisor) {
            Q.daszynski_advisor = 0;
            Q.n_advisors -= 1;
        }
        Q.daszynski_left_adviser_pool = 1;
    }
    // Stage 6: the unions' funds, due settlement clauses and one draw of each strike, before the economy of the
    // period (4.2 step 4; technical reference 14.1–14.5).
    if (Q.polish_union_rules) {
        PolishUnions.beginMonth(Q, settlement);
    }
    if (Q.polish_economy_system) {
        PolishProjects.settleMonth(Q, settlement);
    }
    // Stage 5: the party's own month (13.1–13.4): income, upkeep and arrears, membership, TUR, cooperatives and
    // Milicja fatigue, after the economy and the flows (4.2 step 6).
    if (Q.polish_party_rules) {
        PolishParty.settleMonth(Q, settlement);
    }
    // Stage 6: one round of talks of each strike and the end of an exhausted one (4.2 step 6; 14.3–14.4).
    if (Q.polish_union_rules) {
        PolishUnions.endMonth(Q, settlement);
    }
    // The inherited German economy and its support rules (budget → inflation, growth and
    // unemployment, pro_republic erosion, NSDAP flows and the 1929–1934 drifts) stay in this file for
    // the German baseline and do not run in the Polish game.
    if (!Q.polish_economy_system) {
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties) {
        party_support_results[party] = Q[party + '_normalized']*100;
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Q.inflation,
                             'unemployment': Q.unemployed});
    // change economic stats...
    // we're basically implicity drawing a Philips curve
    // budget deficits lead to some inflation
    if (Q.budget <= 0 && Q.budget > -2 && Q.inflation < 2.5) {
        Q.inflation += 0.1;
    }
    if (Q.budget <= -2 && Q.budget > -5 && Q.inflation < 5) {
        Q.inflation += 0.2;
        if (Q.unemployed >= 12) {
            Q.inflation -= 0.1;
        }
    }
    if (Q.budget <= -5 && Q.inflation < 10) {
        Q.inflation += 0.3;
        if (Q.unemployed >= 15) {
            Q.inflation -= 0.1;
        }
    }
    // deflation is bad
    if (Q.inflation < -0.5 && Q.inflation > -5 && Q.unemployed < 15) {
        Q.unemployed += 0.2;
    }
    if (Q.inflation <= -5 && Q.unemployed < 20) {
        Q.unemployed += 0.3;
    }
    // economic growth
    if (Q.economic_growth < -0.5 && Q.unemployed <= 18) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth < -5 && Q.unemployed <= 28) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth >= 2 && Q.unemployed >= 17) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.unemployed >= 12) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 6 && Q.unemployed >= 7) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 8 && Q.unemployed >= 3) {
        Q.unemployed -= 0.1;
    }
    if (Q.economic_growth >= 4 && Q.inflation >= 7.5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= -2.5 && Q.inflation <= -5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 7) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 10) {
        Q.economic_growth -= 0.2;
    }
    if (Q.economic_growth >= 12) {
        Q.economic_growth -= 0.3;
    }

    //////////////////////////////// Education & Science support/economic changes
    if (Q.major_curriculum && Q.major_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.5;
        } 
    }
    if (Q.minor_curriculum && Q.minor_curriculum == "democratic") {
        if (Q.pro_republic < 60) {
            Q.pro_republic += 0.3;
        } 
    }
    // science bonus to economic growth
    // education bonus
    Q.science_bonus = 0;
    if (Q.education_science) {
        Q.science_bonus += Q.education_science;
    }
    if (Q.science) {
        if (Q.science >= 1) {
            Q.science_bonus += 1;
        } else if (Q.science >= 3) {
            Q.science_bonus += 2;
        } else if (Q.science >= 5) {
            Q.science_bonus += 3;
        }
    }
    if (Q.applied_research && Q.applied_research >= 1) {
        Q.science_bonus += 0.5*Q.applied_research;
    }
    // cap the science bonus at 6
    if (Q.science_bonus > 6) {
        Q.science_bonus = 6;
    }
    console.log(Q.science_bonus);
    // this is kinda messy but basically more science -> higher levels of baseline growth
    if (Q.science_bonus >= 1) {
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus + 3) {
            Q.economic_growth += 0.1;
        }
        if (Q.return_to_normalcy && Q.economic_growth < Q.science_bonus) {
            Q.economic_growth += 0.1;
        }
        if (Q.economic_growth < Q.science_bonus - 3) {
            Q.economic_growth += 0.1;
        }
    }
    // accumulated economic growth/decline
    // Maybe there should be differences for positive/negative growth?
    if (Q.economic_growth < 0) {
        if (Q.economic_expansion > 0) {
            Q.economic_expansion = 0;
        } else {
            Q.economic_expansion += Q.economic_growth;
        }
    }
    if (Q.economic_growth > 0 && Q.reparations <= -2 && Q.spd_in_government) {
        Q.economic_expansion += Q.economic_growth;
    } else if (Q.economic_growth > 0 && Q.spd_in_government) {
        Q.economic_expansion += Q.economic_growth/2;
    }
    /////////////////////////////// update opinions based on economy
    if (Q.unemployed > 15 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }
    if (Q.unemployed > 30 && Q.pro_republic > 20) {
        Q.pro_republic -= 1;
    }
    if (Q.inflation >= 8 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }

    ///////////////////////////// change party support based on pro_republic
    // if pro_republic is less than the support of the Weimar coalition, reduce SPD support...
    if (Q.pro_republic < (Q.spd_votes + Q.ddp_votes + Q.z_votes - 3)) {
        if (Q.new_middle_spd > 0) {
            Q.new_middle_spd -= 5/12;
            Q.new_middle_nsdap += 3/12;
        }
        if (Q.old_middle_spd > 0) {
            Q.old_middle_spd -= 5/12;
            Q.old_middle_nsdap += 3/12;
        }
        if (Q.rural_spd > 0) {
            Q.rural_spd -= 5/12;
            Q.rural_nsdap += 3/12;
        }
        if (Q.workers_spd_normalized > 30) {
            Q.workers_spd -= 4/12;
        }
        if (Q.catholics_spd > 0) {
            Q.catholics_spd -= 4/12;
        }
        if (Q.unemployed_spd_normalized > 10) {
            Q.unemployed_spd -= 4/12;
        }
        if (Q.new_middle_ddp > 0) {
            Q.new_middle_ddp -= 4/12;
            Q.new_middle_nsdap += 3/12;
        }
        if (Q.old_middle_ddp > 0) {
            Q.old_middle_ddp -= 5/12;
            Q.old_middle_nsdap += 4/12;
        }
        if (Q.rural_ddp > 0) {
            Q.rural_ddp -= 5/12;
            Q.rural_nsdap += 4/12;
        }
    }

    ////////////////////////// annual support changes
    if (Q.year == 1929) {
        Q.unemployed += 3/12;
        Q.inflation -= 1/12;
        // increase NSDAP vote share
        Q.new_middle_nsdap += 10/12;
        Q.old_middle_nsdap += 10/12;
        Q.new_middle_ddp -= 5/12;
        Q.new_middle_dvp -= 5/12;
        Q.workers_kpd += 5/12;
        Q.sa_strength += 50/12;
        Q.sh_strength += 100/12;
        Q.rural_dnvp -= 15/12;
        Q.rural_nsdap += 10/12;
        Q.unemployed_nsdap += 18/12;
    } else if (Q.year == 1930) {
        Q.rural_nsdap += 10/12;
        Q.rural_dnvp -= 15/12;
        Q.new_middle_dvp -= 5/12;
        Q.old_middle_dvp -= 6/12;
        Q.new_middle_ddp -= 5/12;
        Q.old_middle_ddp -= 6/12;
        Q.new_middle_nsdap += 10/12;
        Q.old_middle_nsdap += 10/12;
        Q.new_middle_other += 4/12;
        Q.old_middle_other += 4/12;
        Q.unemployed_nsdap += 8/12;
        Q.rural_other += 5/12;

        Q.workers_z += 1/12;
        Q.old_middle_z += 2/12;
        Q.new_middle_z += 2/12;
        if (!Q.works_program) {
            Q.rural_nsdap += 3/12;
            Q.old_middle_nsdap += 5/12;
            Q.workers_nsdap += 2/12;
            Q.workers_other += 5/12;
            Q.workers_kpd += 2/12;
        }
        Q.sa_strength += 100/12;
        Q.sh_strength += 100/12;
    } else if (Q.year == 1931) {
        Q.catholics_z += 2/12;
        Q.rural_dvp -= 8/12;
        Q.old_middle_dvp -= 8/12;
        Q.new_middle_dvp -= 8/12;
        Q.old_middle_ddp -= 8/12;
        Q.new_middle_ddp -= 8/12;
        Q.sa_strength += 50/12;
        Q.sh_strength += 50/12;
        Q.sa_militancy += 0.1/12;
        Q.old_middle_nsdap += 10/12;
        Q.rural_other -= 5/12;
        Q.rural_nsdap += 9/12;
        // TODO: economic policies should reduce NSDAP rurals
        if (!Q.works_program) {
            Q.old_middle_dvp -= 6/12;
            Q.new_middle_dvp -= 6/12;
            Q.rural_dvp -= 6/12;
            Q.unemployed_nsdap += 7/12;
            Q.unemployed_kpd += 2/12;
            Q.rural_other -= 12/12;
            Q.rural_nsdap += 12/12;
            Q.new_middle_nsdap += 12/12;
            Q.old_middle_nsdap += 12/12;
            Q.workers_nsdap += 2/12;
            Q.workers_kpd += 4/12;
            Q.sa_strength += 100/12;
            Q.sh_strength += 50/12;
        } else if (Q.unemployed > 15) {
            Q.old_middle_dvp -= 4/12;
            Q.new_middle_dvp -= 4/12;
            Q.rural_dvp -= 4/12;
            Q.unemployed_nsdap += 4/12;
            Q.old_middle_nsdap += 4/12;
            Q.new_middle_nsdap += 4/12;
            Q.rural_nsdap += 4/12;
        }
    } else if (Q.year == 1932) {
        Q.old_middle_other -= 7/12;
        Q.rural_other -= 7/12;
        Q.old_middle_nsdap += 7/12;
        Q.rural_nsdap += 7/12;
        Q.unemployed_nsdap += 4/12;
        if (!Q.works_program) {
            Q.unemployed += 5/12;
            Q.inflation -= 2/12;
            Q.catholics_z += 2/12;
            Q.rural_dnvp -= 4/12;
            Q.rural_nsdap += 8/12;
            Q.new_middle_nsdap += 10/12;
            Q.old_middle_nsdap += 10/12;
            Q.unemployed_nsdap += 8/12;
            Q.unemployed_kpd += 2/12;
            Q.workers_nsdap += 3/12;
            Q.workers_kpd += 3/12;
            Q.sa_strength += 200/12;
            Q.new_middle_dnvp += 4/12;
            Q.new_middle_dnvp += 4/12;
            Q.new_middle_dvp -= 4/12;
            Q.old_middle_dvp -= 4/12;
            Q.rural_dvp -= 4/12;
        } else if (Q.unemployed > 25) {
            Q.rural_nsdap += 5/12;
            Q.unemployed_nsdap += 5/12;
            Q.old_middle_nsdap += 5/12;
            Q.new_middle_nsdap += 4/12;
            Q.sa_strength += 50/12;
        } else if (Q.unemployed > 20) {
            Q.rural_nsdap += 2/12;
            Q.unemployed_nsdap += 3/12;
            Q.old_middle_nsdap += 3/12;
            Q.new_middle_nsdap += 2/12;
        }
    } else if (Q.year >= 1933) {
        if (Q.return_to_normalcy) {
            // return to normalcy -> voters return to the base
            if (Q.new_middle_ddp_normalized < 40) {
                Q.new_middle_ddp += 6/12;
            }
            if (Q.new_middle_dvp_normalized < 25) {
                Q.new_middle_dvp += 3/12;
            }
            if (Q.old_middle_dvp_normalized < 40) {
                Q.old_middle_dvp += 6/12;
            }
            if (Q.rural_dnvp_normalized < 40) {
                Q.rural_dnvp += 6/12;
            }
            if (Q.national_minorities_z_normalized < 40) {
                Q.catholics_z += 6/12;
            }
        }
        if (Q.unemployed > 20) {
            Q.rural_nsdap += 2/12;
            Q.unemployed_nsdap += 2/12;
            Q.old_middle_nsdap += 2/12;
            Q.new_middle_nsdap += 2/12;
            if (Q.spd_in_government) {
                Q.workers_spd -= 4/12;
            }
        }
    }
    // prevent forever support if the economy is bad
    if (Q.year >= 1934 && (Q.inflation >= 8 || Q.unemployed >= 20) && Q.pro_republic <= 45 && Q.spd_in_government) {
        if (Q.workers_spd_normalized > 40) {
            Q.workers_spd -= 6/12;
        }
        if (Q.unemployed_spd_normalized > 20) {
            Q.unemployed_spd -= 6/12;
        }
        if (Q.new_middle_spd_normalized > 20) {
            Q.new_middle_spd -= 6/12;
        }
        if (Q.old_middle_spd_normalized > 20) {
            Q.old_middle_spd -= 6/12;
        }
        if (Q.rural_spd_normalized > 20) {
            Q.rural_spd -= 6/12;
        }
        if (Q.national_minorities_spd_normalized > 20) {
            Q.catholics_spd -= 6/12;
        }
    }

    }

    // Approved structural trend: from January 1922 through December 1939,
    // Chłopi decline linearly from 53% to 50% while Robotnicy rise from 27% to 30%.
    var demographic_month = (Q.year - 1922)*12 + (Q.month - 1);
    var demographic_progress = Math.max(0, Math.min(1, demographic_month/215));
    Q.workers = 27 + 3*demographic_progress;
    Q.rural = 53 - 3*demographic_progress;
    if (Q.polish_party_rules) {
        PolishElectorate.applyClassShares(Q.S, {workers: Q.workers, old_middle: Q.old_middle, new_middle: Q.new_middle,
            rural: Q.rural, bourgeois_landowners: Q.bourgeois_landowners});
    }
    // Agreements (technical reference 9.2, 4.2 step 6): fulfilment, breaches and tension once a month,
    // then warnings, ultimatums and their expiry, and a dismissal motion left without an answer.
    PolishGovernment.syncRelations(Q);
    PolishGovernment.settleAgreements(Q);
    PolishGovernment.writeGovernmentMirrors(Q);
    // Stage 5: a broken own promise of PPS costs trust and support among its recipients (5.4).
    if (Q.polish_party_rules) {
        PolishParty.afterAgreements(Q);
    }
    // Stage 7 (4.2 step 6): the recorded effects reach the cells, then grievance and radicalisation, the journal and
    // the authority of the Sejm, the pressure towards a coup, democracy and violence (15.1–15.3).
    if (Q.polish_politics_rules) {
        PolishPolitics.settleMonth(Q, settlement);
    }
    // Stage 7 (16.1–16.3, 16.7): the temporary modifiers of the forces, the execution and review of the agreement with
    // Piłsudski, after democracy of this month.
    if (Q.polish_security_rules) {
        PolishSecurity.settleMonth(Q, settlement);
    }
    if (Q.polish_economy_system) {
        // 4.2 step 7: one record of period t, after the flow of 5.6 changed the class rows.
        recomputeSupport();
        var polish_support = {'date': new Date(PolishRules.yearOf(settlement.t), PolishRules.monthOf(settlement.t) - 1)};
        for (var party of Q.parties) {
            polish_support[party] = Q[party + '_normalized']*100;
        }
        Q.party_support_records.push(polish_support);
        PolishEconomy.writeEconomyMirrors(Q);
        Q.economic_records.push({'date': new Date(PolishRules.yearOf(settlement.t), PolishRules.monthOf(settlement.t) - 1),
                                 'inflation': Q.S.economy.inflation_m,
                                 'unemployment': Q.S.economy.unemployment});
    }
    PolishRules.completeMonthSettlement(Q, settlement);
}
if (Q.polish_economy_system) {
    PolishEconomy.writeEconomyMirrors(Q);
}
if (Q.polish_party_rules) {
    PolishParty.writeMirrors(Q);
}
PolishRules.refreshMirrors(Q);
// Stage 7: after an event package, before the next ordinary action (4.2): the speeches and impulses due now.
if (Q.polish_politics_rules) {
    PolishPolitics.afterEvents(Q);
}
Q.has_event = 0;
// Event queue (technical reference 4.5): the Polish events that are due now, one at a time in a
// fixed order. German events keep the tag event and are no longer offered (implementation plan,
// stage 1).
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene) || [];
var due = choices.filter(function(choice) {
    return choice.canChoose !== false && choice.title != "Continue...";
}).map(function(choice) { return choice.id; });
var next_event = PolishRules.nextEvent(Q, due);
if (next_event) {
    Q.pl_next_event = next_event;
    Q.has_event = 1;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}

if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: polish_incompatible_save if pl_route = "incompatible"; polish_chapter_report if pl_route = "report"; sejm_election if pl_route = "sejm"; polish_speaker_election if pl_route = "speaker"; polish_presidential_sequence if pl_route = "presidency"; polish_cabinet_formation if pl_route = "cabinet"; polish_event_router if pl_route = "event"; main if pl_route = ""

= [+ month : month +] [+ year +]

@events_choice

- #pl_event

# This scene is solely for updating numbers after events, and routing to special events.
