// Narrow compatibility bridge for inherited cards. Only the explicitly
// approved direct mappings feed back into active Polish party support.
Q.legacy_party_map = {'spd': 'pps', 'kpd': 'kpp', 'dvp': 'pschd', 'dnvp': 'zln'};
for (var legacy_party in Q.legacy_party_map) {
    var polish_party = Q.legacy_party_map[legacy_party];
    for (var population_group of Q.classes) {
        Q[population_group + '_' + legacy_party] = Q[population_group + '_' + polish_party];
        Q[population_group + '_' + legacy_party + '_compat_base'] = Q[population_group + '_' + polish_party];
    }
}
for (var inactive_party of ['z', 'ddp', 'nsdap']) {
    for (var population_group of Q.classes) {
        Q[population_group + '_' + inactive_party] = 0;
    }
    Q[inactive_party + '_normalized'] = 0;
    Q[inactive_party + '_votes'] = 0;
    Q[inactive_party + '_r'] = 0;
}
// Catholic-targeting cards remain as a temporary compatibility input for the
// PPS minority row, but the election algorithm no longer overwrites the full
// minority profile from Catholic values.
Q.catholics_spd = Q.national_minorities_pps;
Q.catholics_spd_compat_base = Q.catholics_spd;


// Approved simplification: 444 MPs from January 1922, using the user's rounded
// August shares (100.1% total), NOT current polling or a January historical roster.
// Integer tenths avoid floating-point ties. Largest remainders allocate exactly
// 444 seats; ties use the existing party order. This is a parliamentary snapshot,
// not an election or a measurement of January voting intentions.
Q.sejm_total_seats = 444;
Q.opening_sejm_active = 1;
Q.opening_sejm_seats = {};
var opening_weights = [5, 79, 49, 56, 222, 60, 188, 39, 303];
var opening_weight_total = opening_weights.reduce(function(sum, value) { return sum + value; }, 0);
var opening_remainders = [];
var seats_assigned = 0;
Q.parties.forEach(function(party, index) {
    var numerator = opening_weights[index] * Q.sejm_total_seats;
    var seats = Math.floor(numerator / opening_weight_total);
    Q.opening_sejm_seats[party] = seats;
    seats_assigned += seats;
    opening_remainders.push({party: party, index: index, remainder: numerator % opening_weight_total});
});
opening_remainders.sort(function(a, b) { return b.remainder - a.remainder || a.index - b.index; });
for (var seat = 0; seat < Q.sejm_total_seats - seats_assigned; seat++) {
    Q.opening_sejm_seats[opening_remainders[seat].party] += 1;
}
for (var party of Q.parties) {
    Q[party + '_r'] = 100 * Q.opening_sejm_seats[party] / Q.sejm_total_seats;
}
Q.polish_election_system = 1;
Q.polish_government_safeguards = 1;
Q.sejm_first_election_completed = 0;
Q.sejm_pending = null;
Q.sejm_results = [];
Q.sejm_election_error = '';
Q.sejm_parliament = {
    id: 'opening_1922', kind: 'opening_snapshot', total_seats: Q.sejm_total_seats,
    party_seats: Object.assign({}, Q.opening_sejm_seats),
    party_names: Object.assign({}, Q.party_names)
};

// Polish presidential succession is separate from the inherited direct-popular
// German presidency. The semantic object is authoritative; the legacy
// `president` and `presidential_powers` fields are deliberately not reused.
Q.polish_presidential_system = 1;
Q.polish_presidential_sequence_completed = 0;
Q.polish_presidential_pending = null;
Q.polish_presidential_due = 0;
Q.polish_presidential_in_progress = 0;
Q.polish_presidential_phase = '';
Q.polish_presidency = {
    constitution: {
        id: 'march_constitution_1921',
        election_body: 'national_assembly',
        term_years: 7,
        government_acts_require_countersignature: true,
        appoints_prime_minister: true,
        appoints_ministers_on_prime_minister_proposal: true,
        legislative_veto: false,
        independent_decrees: false,
        dissolve_sejm: 'requires_three_fifths_senate_consent'
    },
    current: {
        office_id: 'naczelnik_panstwa',
        holder_id: 'jozef_pilsudski',
        holder_name: 'Józef Piłsudski',
        status: 'incumbent',
        since: '1922-01-01-game-opening'
    },
    assembly: null,
    elections: [],
    transitions: [],
    pps_decisions: []
};

for (var party of Q.parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'];
}
// Parliamentary aliases used by inherited, still-temporary German content.
Q.spd_r = Q.pps_r;
Q.kpd_r = Q.kpp_r;
Q.dvp_r = Q.pschd_r;
Q.dnvp_r = Q.zln_r;
Q.old_spd_r = Q.spd_r;
Q.old_kpd_r = Q.kpd_r;
Q.old_dvp_r = Q.dvp_r;
Q.old_dnvp_r = Q.dnvp_r;

// sapd isn't formed yet, but it may be formed
Q.sapd_r = 0;
Q.old_sapd_r = 0;

// Planned party lifecycle labels. Only ZLN is active in this slice.
Q.zln_name = "ZLN";
Q.sl_formed = 0;
Q.bbwr_formed = 0;
Q.ozn_formed = 0;

// array of objects of the form {date: Date(), spd: 10, kpd: 12, ...} for each election
Q.election_records = [];
// party support records for every month
Q.party_support_records = [];
// inflation and unemployment records
Q.economic_records = [];


// January 1922 opening. Legacy office keys remain for unconverted consumers;
// Piłsudski is NOT put in the presidency or connected to PPS faction state.
Q.polish_opening_government_active = 1;
Q.polish_cabinet_id = 'ponikowski_1';
Q.head_of_state_office = 'naczelnik_panstwa';
Q.head_of_state_name = 'Józef Piłsudski';
Q.pps_external_toleration = 1;
Q.president = '';
Q.chancellor = 'Antoni Ponikowski';
Q.chancellor_party = 'expert_cabinet';
Q.spd_in_government = 0;
Q.spd_caretaker = 0;
Q.pps_in_government = 0;
Q.kpp_in_government = 0;
Q.npr_in_government = 0;
Q.psl_wyzwolenie_in_government = 0;
Q.psl_piast_in_government = 0;
Q.pschd_in_government = 0;
Q.zln_in_government = 0;
Q.minorities_bloc_in_government = 0;
Q.z_in_government = 0;
Q.ddp_in_government = 0;
Q.dvp_in_government = 0;
Q.dnvp_in_government = 0;
Q.kpd_in_government = 0;
Q.nsdap_in_government = 0;

Q.in_right_coalition = 0;
// Weimar coalition = SPD + Z + DDP
Q.in_weimar_coalition = 0;
// Grand coalition = SPD + Z + BVP + DDP + DVP
// also includes the "new grand coalition" of SPD + Z + BVP + DDP + DVP + Others
Q.in_grand_coalition = 0;
// Popular front = SPD + KPD + Z + DDP
Q.in_popular_front = 0;
// left coalition = SPD + KPD + left-splinters
Q.in_left_front = 0;
// emergency government containing the SPD: only president Braun can do this.
Q.in_emergency_government = 0;
Q.in_spd_majority = 0;
Q.grand_coalition_failed = 0;
// if the SPD is ruling as part of a minority government
Q.in_minority_government = 0;
Q.in_polish_left_coalition = 0;
Q.in_polish_center_left_coalition = 0;
Q.in_chjeno_piast = 0;
Q.minorities_toleration = 0;
// national unity governmet

// if you're in a coalition, this is an incremental counter for how many times dissent has happened from the right.
Q.coalition_dissent = 0;
// dissent from the KPD, in a popular front or left front government
Q.kpd_coalition_dissent = 0;

// German toleration routes are NOT the Polish external-toleration relationship.
Q.spd_toleration = 0;

// is the current government a presidential minority government?
Q.minority_government = 0;

// Stable Polish gameplay portfolios, not an exact roster of historical ministries.
// Existing keys are retained to avoid rewriting policy mechanics. New portfolios
// are display/state only; no policy cards or allocation system are added.
Q.polish_portfolios = {
    labor: 'Praca i Opieka Społeczna',
    interior: 'Sprawy Wewnętrzne',
    finance: 'Skarb',
    economic: 'Przemysł i Handel',
    justice: 'Sprawiedliwość',
    foreign: 'Sprawy Zagraniczne',
    agriculture: 'Rolnictwo i Dobra Państwowe',
    reichswehr: 'Sprawy Wojskowe',
    education: 'Wyznania Religijne i Oświecenie Publiczne',
    public_works: 'Roboty Publiczne i Komunikacja'
};
for (var portfolio in Q.polish_portfolios) {
    Q[portfolio + '_minister'] = '';
    // This means cabinet-administered, not that every incumbent was non-party.
    Q[portfolio + '_minister_party'] = 'opening_expert_cabinet';
}

// Events: what has occurred?
Q.panzerkreuzer_seen = 0;
Q.panzerkreuzer_funded = 0;
Q.panzerkreuzer_failed = 0;
Q.unemployment_insurance_seen = 0;
// unemployment insurance event is seen if the unemployment level is at least 4 more than the threshold...
