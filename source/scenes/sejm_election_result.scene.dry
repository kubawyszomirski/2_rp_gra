title: Record a Sejm election
on-arrival: {!
// One atomic result writer (technical reference 6.1–6.4). The rules module calculates and
// publishes the result, the clubs, the Senate and the next legal date in one transaction; the saved
// election ID and phase make navigation and save re-entry idempotent.
Q.sejm_election_error = '';
var pending = Q.sejm_pending;
if (!Q.polish_election_system || !pending || pending.phase !== 'pending') return;
var recorded = PolishInstitutions.recordSejmElection(Q, pending);
if (!recorded.ok) {
    Q.sejm_election_error = recorded.error || '';
    return;
}
Q.opening_sejm_active = 0;
Q.in_election = 1;
// Stage 5 (M16): the new PPS club is divided among the factions by their strength on the day of the result;
// later only a real transfer changes that division.
if (Q.polish_party_rules) PolishParty.ensureFactionSeats(Q);
// No monthly action, Papen timer or German election achievement is awarded. The next election
// date comes from the legal record in Q.S.parliament (7.4); polish_opening_state mirrors it.
// The next lawful result ends the chapter before a new government is formed (19.1), so the
// government in office stays as it is and goes into the report.
if (PolishInstitutions.endChapterIfDue(Q)) return;
// The certified result opens the mandatory cabinet formation (technical reference 8.8); the previous
// cabinet stays as caretaker until a new one is appointed. The German coalition flags and the ten
// inherited portfolio keys are no longer reset here: they mirror the cabinet record.
PolishGovernment.beginPostElectionFormation(Q);
PolishGovernment.writeGovernmentMirrors(Q);
!}
