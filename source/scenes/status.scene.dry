title: Status
new-page: true
is-special: true
call: polish_opening_state
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
// The party lines are computed here as well, so a save from before 0.54 shows them at once (Z — 0.54).
if (Q.polish_party_rules && typeof PolishParty !== 'undefined') {
    PolishParty.sidebarDisplay(Q);
}
// The Party tab of the top bar also shows the Milicja PPS and the nine positions of the party line.
if (Q.polish_security_rules && Q.S && typeof PolishSecurity !== 'undefined' && PolishSecurity.ready(Q)) {
    PolishSecurity.defenseView(Q);
}
if (Q.S && typeof PolishTopbar !== 'undefined') {
    PolishTopbar.lineView(Q);
}
!}

# The sidebar: one fact per line under section headings (Z — 0.54), each with a bold label (Z — 0.55). Z — 0.76 (the user's
