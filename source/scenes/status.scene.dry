@polls
on-arrival: {!
Q.pro_republic_disp = Math.round(Q.pro_republic);
// Stage 7: the Polish game reads its own attachment to democracy (15.2), not the German support for the Republic.
Q.pl_democracy_disp = Q.polish_politics_rules && Q.S && Q.S.politics ? Math.round(Q.S.politics.democracy) : 0;
Q.nationalism_disp = Math.round(Q.nationalism);
Q.socialism_disp = Math.round(Q.socialism);
!}

